# Kili — obligatoire pour tous les scripts qui parlent à l'instance.
KILI_API_KEY=
KILI_API_ENDPOINT=https://cloud.kili-technology.com/api/label/v2/graphql
# Bundle de certificats, pour une instance derrière un proxy d'entreprise.
# Laisser vide pour utiliser les certificats du système.
KILI_CA_BUNDLE=

# Anthropic — LLM-as-judge. Inutile en mode --hors-ligne.
ANTHROPIC_API_KEY=

# Jina — embeddings de l'appariement hybride. Inutile en mode --hors-ligne.
JINA_API_KEY=

# Gabarit d'URL des documents sources, pour rendre les sources
# consultables depuis la carte. Placeholders : {doc_id} et {page}.
# Laisser vide si les documents ne sont publiés nulle part.
# DOCUMENT_URL_TEMPLATE=https://contoso.sharepoint.com/sites/assurance/Documents/{doc_id}#page={page}

# Surcharges facultatives (valeurs par défaut dans src/rag_referentiel/config.py)
# MATCH_THRESHOLD_HIGH=0.72
# MATCH_THRESHOLD_LOW=0.45
# LEXICAL_WEIGHT=0.4
# SEMANTIC_WEIGHT=0.6
# NEAR_DUPLICATE_THRESHOLD=0.85
# VARIANT_CAP=5
# JUDGE_MODEL=claude-sonnet-5
# EMBEDDING_MODEL=jina-embeddings-v5-nano
# MAX_METADATA_SIZE=60000
